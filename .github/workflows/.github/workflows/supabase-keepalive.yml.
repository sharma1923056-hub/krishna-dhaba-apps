name: Keep Supabase awake

# Supabase's free plan pauses a project after about a week with no activity.
# This sends one tiny read request every 3 days so the project stays active.
on:
  schedule:
    - cron: '17 4 */3 * *'
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping the database
        env:
          URL: ${{ secrets.SUPABASE_URL }}
          KEY: ${{ secrets.SUPABASE_ANON_KEY }}
        run: |
          if [ -z "$URL" ] || [ -z "$KEY" ]; then echo "::error::Missing SUPABASE_URL / SUPABASE_ANON_KEY secrets"; exit 1; fi
          curl -fsS --max-time 30 "$URL/rest/v1/restaurants?select=id&limit=1" \
            -H "apikey: $KEY" -H "Authorization: Bearer $KEY"
